rules_version = '2';
// Community feed. Posts and comments are readable by everyone and written
// only as the signed-in user. Counters may only change by one, together with the
// matching like/comment document.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validText(v, max) { return v is string && v.size() <= max; }
    // An admin is a signed-in user with a document at admins/<uid>, created by hand in the console.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Nobody can write admins from the app. A user can only check their own entry.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Custom recipes synced from the app. Anyone (also guests) can add one, but an
    // existing recipe can only be changed or deleted by the signed-in user who owns it.
    // (Recipes saved before this rule have no owner, so nobody can change them from the app.)
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if validText(request.resource.data.id, 120)
        && validText(request.resource.data.title, 200)
        && request.resource.size() < 100000
        && (!('ownerId' in request.resource.data)
            || (signedIn() && request.resource.data.ownerId == request.auth.uid));
      allow update, delete: if signedIn()
        && resource.data.get('ownerId', '') == request.auth.uid
        && (request.method == 'delete' || request.resource.data.ownerId == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && validText(request.resource.data.title, 80)
        && request.resource.data.title.size() > 0
        && validText(request.resource.data.text, 1000)
        && (!('photoUrl' in request.resource.data)
            || request.resource.data.photoUrl.matches('https://arewecookin-photos[.]areyouskurtz[.]workers[.]dev/p/.*'))
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      // Only the counters can change, and only by 1.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
        && (request.resource.data.likeCount - resource.data.likeCount) in [-1, 0, 1]
        && (request.resource.data.commentCount - resource.data.commentCount) in [0, 1];

      match /likes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && validText(request.resource.data.text, 500)
          && request.resource.data.text.size() > 0;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // Reports: anyone signed in can file one about a post. Only admins can read them
    // and mark them handled (status only).
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['removed', 'dismissed'];
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && validText(request.resource.data.reason, 100);
    }
  }
}
