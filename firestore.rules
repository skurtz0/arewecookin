rules_version = '2';
// Community feed. Posts and comments are readable by everyone and written
// only as the signed-in user. Counters may only change by one, together with the
// matching like/comment document.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validText(v, max) { return v is string && v.size() <= max; }
    function photoOk(u) { return u is string && u.matches('https://arewecookin-photos[.]areyouskurtz[.]workers[.]dev/p/.*'); }
    // Up to 10 photo URLs, each from our own photo worker (no iteration in rules, so check each slot).
    function photosOk(l) {
      return l is list && l.size() <= 10
        && (l.size() < 1 || photoOk(l[0])) && (l.size() < 2 || photoOk(l[1]))
        && (l.size() < 3 || photoOk(l[2])) && (l.size() < 4 || photoOk(l[3]))
        && (l.size() < 5 || photoOk(l[4])) && (l.size() < 6 || photoOk(l[5]))
        && (l.size() < 7 || photoOk(l[6])) && (l.size() < 8 || photoOk(l[7]))
        && (l.size() < 9 || photoOk(l[8])) && (l.size() < 10 || photoOk(l[9]));
    }
    // An admin is a signed-in user with a document at admins/<uid>, created by hand in the console.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Nobody can write admins from the app. A user can only check their own entry.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Custom recipes synced from the app. Anyone (also guests) can add one, but an
    // existing recipe can only be changed or deleted by the signed-in user who owns it.
    // (Recipes saved before this rule have no owner, so nobody can change them from the app.)
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if validText(request.resource.data.id, 120)
        && validText(request.resource.data.title, 200)
        && request.resource.size() < 100000
        && (!('ownerId' in request.resource.data)
            || (signedIn() && request.resource.data.ownerId == request.auth.uid));
      allow update, delete: if signedIn()
        && resource.data.get('ownerId', '') == request.auth.uid
        && (request.method == 'delete' || request.resource.data.ownerId == request.auth.uid);
    }

    // Blocked authors, kept on the account so a block follows the user to every device.
    match /users/{uid}/blocked/{blockedUid} {
      // Listing the collection has no blockedUid, so reads only check the owner.
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, delete: if signedIn() && request.auth.uid == uid && blockedUid != uid;
    }

    // Public profile: only its owner writes, only these fields. Pinned posts: at most 3 ids.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'bio', 'photoUrl', 'pinned'])
        && validText(request.resource.data.get('displayName', ''), 40)
        && validText(request.resource.data.get('bio', ''), 150)
        && (!('photoUrl' in request.resource.data) || photoOk(request.resource.data.photoUrl))
        && (!('pinned' in request.resource.data)
            || (request.resource.data.pinned is list && request.resource.data.pinned.size() <= 3
                && (request.resource.data.pinned.size() < 1 || validText(request.resource.data.pinned[0], 40))
                && (request.resource.data.pinned.size() < 2 || validText(request.resource.data.pinned[1], 40))
                && (request.resource.data.pinned.size() < 3 || validText(request.resource.data.pinned[2], 40))));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Follow graph: one document per follow, id = <follower>_<followee>. Public like on Instagram.
    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerId', 'followeeId', 'createdAtMs'])
        && request.resource.data.followerId == request.auth.uid
        && validText(request.resource.data.followeeId, 128)
        && request.resource.data.followeeId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followeeId;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
    }

    // 24-hour photo stories. Everyone can see them; only the author creates/deletes (or an admin deletes).
    // The timestamp must be close to the server time and expiresAtMs exactly 24 h later.
    match /stories/{storyId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'photoUrl', 'createdAtMs', 'expiresAtMs'])
        && request.resource.data.authorId == request.auth.uid
        && validText(request.resource.data.authorName, 80)
        && photoOk(request.resource.data.photoUrl)
        && request.resource.data.createdAtMs is int
        && request.resource.data.createdAtMs > request.time.toMillis() - 600000
        && request.resource.data.createdAtMs < request.time.toMillis() + 600000
        && request.resource.data.expiresAtMs == request.resource.data.createdAtMs + 86400000;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      // Who watched: a viewer writes only their own entry; only the story's author reads the list.
      match /views/{viewerId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid;
        allow create, update: if signedIn() && request.auth.uid == viewerId
          && request.resource.data.keys().hasOnly(['name', 'atMs'])
          && validText(request.resource.data.name, 80);
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && validText(request.resource.data.title, 80)
        && request.resource.data.title.size() > 0
        && validText(request.resource.data.text, 1000)
        && (!('photoUrl' in request.resource.data) || photoOk(request.resource.data.photoUrl))
        && (!('photoUrls' in request.resource.data) || photosOk(request.resource.data.photoUrls))
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      // An admin removing a comment lowers the comment counter by one (nothing else changes).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && request.resource.data.commentCount - resource.data.commentCount == -1
        && request.resource.data.commentCount >= 0;
      // Only the counters can change, and only by 1.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
        && (request.resource.data.likeCount - resource.data.likeCount) in [-1, 0, 1]
        && (request.resource.data.commentCount - resource.data.commentCount) in [0, 1];

      match /likes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && validText(request.resource.data.text, 500)
          && request.resource.data.text.size() > 0;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // Reports: anyone signed in can file one about a post. Only admins can read them
    // and mark them handled (status only).
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['removed', 'dismissed'];
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && validText(request.resource.data.reason, 100)
        && (!('commentId' in request.resource.data) || validText(request.resource.data.commentId, 60));
    }
  }
}
